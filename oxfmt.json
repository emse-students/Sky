{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "svelte": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/.svelte-kit/**",
    "**/coverage/**",
    "**/src/lib/paraglide/**",
    "**/project.inlang/**",
    "**/database/*.db",
    "**/database/positions.json",
    "**/*.tsbuildinfo",
    "**/.env",
    "**/.env.local",
    "**/bun.lock"
  ]
}
