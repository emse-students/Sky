{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": true,
    "moduleResolution": "bundler",
    // `bun:sqlite` is a runtime-provided module with no package on disk, so it resolves only
    // once bun's own types are loaded. Safe to narrow `types` to this one entry: `@types/bun`
    // depends on `bun-types`, which depends on `@types/node`, so node globals still resolve.
    "types": ["bun", "$app/types"],
    "paths": { "#lib/*": ["./src/lib/*"] }
  },
  // Aliases are package.json `imports` (`#lib/*`), see https://svelte.dev/docs/kit/$lib
  //
  // To make changes to top-level options such as include and exclude, we recommend extending
  // the generated config; see https://svelte.dev/docs/kit/configuration#typescript
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "*.config.js",
    "*.config.cjs",
    "database/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
