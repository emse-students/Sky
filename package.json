{
  "name": "sky-sveltekit",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "husky",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "check": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:watch": "bun run paraglide:compile && svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint -c .oxlintrc.json . && sh ./scripts/run-oxvelte.sh lint --config oxvelte.config.json src",
    "lint:fix": "oxlint -c .oxlintrc.json --fix . && sh ./scripts/run-oxvelte.sh lint --config oxvelte.config.json --fix src",
    "format": "oxfmt -c ./oxfmt.json --write .",
    "format:check": "oxfmt -c ./oxfmt.json --check .",
    "start": "bun run dev",
    "start:prod": "bun scripts/init-db.js && bun scripts/migrate-auth.js && bun scripts/rebuild-db.js && bun scripts/migrate-drop-dead-schema.js && bun build/index.js",
    "db:init": "bun scripts/init-db.js",
    "db:check": "bun scripts/check-db-integrity.js",
    "package": "bun run build && bun ./scripts/pack-bun.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@humanspeak/svelte-markdown": "^1.9.2",
    "@lucide/svelte": "^1.48.0",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "cookie": "^0.7.0",
    "nanoid": "^3.3.18",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.26"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
